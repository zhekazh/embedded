{
	"folders": [
		{
			"name": "m0-blink (root)",
			"path": "."
		},
		{
			"name": "blink (ESP32)",
			"path": "blink"
		},
		{
			"name": "host-c",
			"path": "host-c"
		}
	],
	"extensions": {
		"recommendations": [
			"platformio.platformio-ide",
			"wokwi.wokwi-vscode",
			"ms-vscode.cpptools",
			"marus25.cortex-debug",
			"dan-c-underwood.arm",
			"ms-vscode.cmake-tools",
			"twxs.cmake",
			"github.vscode-github-actions",
			"editorconfig.editorconfig",
			"yzhang.markdown-all-in-one",
			"streetsidesoftware.code-spell-checker",
			"streetsidesoftware.code-spell-checker-ukrainian"
		],
		"unwantedRecommendations": [
			"ms-vscode.cpptools-extension-pack"
		]
	},
	"settings": {
		"files.encoding": "utf8",
		"files.eol": "\n",
		"files.insertFinalNewline": true,
		"files.trimTrailingWhitespace": true,
		"cSpell.language": "en,uk"
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Wokwi GDB",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:blink (ESP32)}/.pio/build/esp32dev/firmware.elf",
				"cwd": "${workspaceFolder:blink (ESP32)}",
				"MIMode": "gdb",
				"miDebuggerPath": "C:/Users/Fujitsu/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-gdb.exe",
				"miDebuggerServerAddress": "localhost:3333"
			}
		]
	}
}
